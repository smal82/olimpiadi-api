const express = require('express');
const puppeteer = require('puppeteer');
const app = express();

// Porta dinamica assegnata da Render
const PORT = process.env.PORT || 3000;

app.get('/', async (req, res) => {
    // Abilita CORS per permettere al tuo sito di chiamare questo servizio
    res.set('Access-Control-Allow-Origin', '*');
    res.set('Access-Control-Allow-Methods', 'GET');
    res.set('Content-Type', 'application/json');

    console.log("Ricevuta richiesta...");

    let browser = null;
    try {
        // Lancia il browser in modalità speciale per Render
        browser = await puppeteer.launch({
            headless: 'new',
            args: [
                '--no-sandbox',
                '--disable-setuid-sandbox',
                '--disable-dev-shm-usage',
                '--single-process' // Importante per Render Free Tier
            ]
        });

        const page = await browser.newPage();

        // Maschera da vero utente Chrome
        await page.setUserAgent('Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36');

        // Calcola la data di oggi
        const today = new Date().toISOString().split('T')[0];
        const targetUrl = `https://www.olympics.com/wmr-owg2026/schedules/api/ITA/schedule/lite/day/${today}`;

        console.log(`Navigazione verso: ${targetUrl}`);

        // Vai all'URL e aspetta che la rete sia inattiva (caricamento finito)
        await page.goto(targetUrl, { 
            waitUntil: 'networkidle2',
            timeout: 30000 
        });

        // Estrai il testo puro dalla pagina (il JSON)
        // Usiamo evaluate per prendere il testo del body, pulito dai tag HTML che Chrome aggiunge
        const content = await page.evaluate(() => {
            return document.querySelector('body').innerText; 
        });

        console.log("Dati estratti. Lunghezza:", content.length);

        // Verifica se è JSON valido
        try {
            JSON.parse(content);
            res.send(content); // Restituisci il JSON puro
        } catch (e) {
            // Se non è JSON, c'è stato un errore/blocco
            console.error("Non è JSON valido:", content.substring(0, 100));
            res.status(500).json({ error: "Il sito ha restituito HTML invece di JSON", details: content.substring(0, 200) });
        }

    } catch (error) {
        console.error("Errore Puppeteer:", error);
        res.status(500).json({ error: error.message });
    } finally {
        if (browser) await browser.close();
    }
});

app.listen(PORT, () => {
    console.log(`Server avviato sulla porta ${PORT}`);
});
